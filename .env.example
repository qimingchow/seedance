# 复制本文件为 .env 并填入你的真实信息
# cp .env.example .env

# ---- 数据库（默认 SQLite，单文件，零配置；多人/多实例可换成 PostgreSQL）----
DATABASE_URL=sqlite:///seedance_studio.db
# 例如 PostgreSQL: postgresql+psycopg://user:password@localhost:5432/seedance
ACCOUNT_TOTAL_TOKENS=0
ACCOUNT_EXTERNAL_USED_TOKENS=0
# Docker Compose 使用：
POSTGRES_DB=seedance
POSTGRES_USER=seedance
POSTGRES_PASSWORD=请替换为强密码

# ---- 火山方舟 Ark（Seedance 视频生成）第二步使用 ----
ARK_API_KEY=你的火山方舟 API Key
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
SEEDANCE_MODEL_PRO=doubao-seedance-2-0-260128
SEEDANCE_MODEL_FAST=doubao-seedance-2-0-fast-260128
SEEDANCE_DEFAULT_MODEL_KEY=pro
# 只开通 Doubao-Seedance-2.0 资源包时，保持 fast=false，避免误用余额计费。
SEEDANCE_ENABLE_PRO=true
SEEDANCE_ENABLE_FAST=false

# ---- 火山引擎对象存储 TOS（第二、三步使用）----
TOS_ACCESS_KEY=你的 TOS Access Key
TOS_SECRET_KEY=你的 TOS Secret Key
TOS_ENDPOINT=tos-cn-beijing.volces.com
TOS_REGION=cn-beijing
TOS_BUCKET=你的 TOS 桶名
# public: 使用桶公共读 URL；signed: 动态生成临时签名 URL，适合公共读 403 或不想公开桶的场景。
TOS_URL_MODE=public
TOS_SIGNED_URL_EXPIRES_SECONDS=604800
# default: 不覆盖对象 ACL；public-read: 上传时显式把对象设为公共读。
TOS_UPLOAD_ACL=default

# ---- 计费换算：1 token = 多少元（用于展示「费用 ¥」，按你的火山定价填写）----
TOKEN_UNIT_PRICE_YUAN=0
# 可选：Seedance 2.0 控制台若区分含/不含视频输入价格，可分别配置。
# 例如 28 元/百万 tokens = 0.000028；46 元/百万 tokens = 0.000046
TOKEN_UNIT_PRICE_WITH_VIDEO_YUAN=0
TOKEN_UNIT_PRICE_NO_VIDEO_YUAN=0
TOKEN_ESTIMATE_SAFETY_MULTIPLIER=1.10

# ---- 运维日志 ----
LOG_LEVEL=INFO
LOG_FILE=logs/seedance.log
LOG_MAX_BYTES=10485760
LOG_BACKUP_COUNT=5

# ---- 可选：非交互创建首个管理员 ----
ADMIN_USERNAME=
ADMIN_PASSWORD=
ADMIN_TOKEN_QUOTA=0
