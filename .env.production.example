# ---- 线上数据库：火山 RDS PostgreSQL ----
DATABASE_URL=postgresql+psycopg://seedance_user:请替换为强密码@你的RDS内网地址:5432/seedance

# ---- 账号额度基准：也可以上线后在管理后台设置 ----
ACCOUNT_TOTAL_TOKENS=0
ACCOUNT_EXTERNAL_USED_TOKENS=0

# ---- 火山方舟 Ark ----
ARK_API_KEY=你的火山方舟APIKey
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
# 火山方舟 OpenAPI（资产组 / 人脸素材入库）。默认可复用 TOS AK/SK；
# 如果你的 IAM 权限拆开了，请单独填写具备 Ark OpenAPI 资产接口权限的 AK/SK。
ARK_OPENAPI_ACCESS_KEY=
ARK_OPENAPI_SECRET_KEY=
ARK_OPENAPI_HOST=ark.cn-beijing.volcengineapi.com
ARK_OPENAPI_REGION=cn-beijing
ARK_OPENAPI_VERSION=2024-01-01
ARK_ASSET_SYNC_ENABLED=true
ARK_ASSET_POLL_INTERVAL_SECONDS=3
ARK_ASSET_POLL_TIMEOUT_SECONDS=120
ARK_ASSET_PROJECT_NAME=
SEEDANCE_MODEL_PRO=doubao-seedance-2-0-260128
SEEDANCE_MODEL_FAST=doubao-seedance-2-0-fast-260128
SEEDANCE_DEFAULT_MODEL_KEY=pro
SEEDANCE_ENABLE_PRO=true
SEEDANCE_ENABLE_FAST=false

# ---- 火山 TOS ----
TOS_ACCESS_KEY=你的TOSAccessKey
TOS_SECRET_KEY=你的TOSSecretKey
TOS_ENDPOINT=tos-cn-beijing.volces.com
TOS_REGION=cn-beijing
TOS_BUCKET=你的桶名
# 团队测试建议 signed，避免公共读策略/对象 ACL 导致 403。
TOS_URL_MODE=signed
TOS_SIGNED_URL_EXPIRES_SECONDS=604800
TOS_UPLOAD_ACL=default

# ---- 计费展示 ----
TOKEN_UNIT_PRICE_YUAN=0
TOKEN_UNIT_PRICE_WITH_VIDEO_YUAN=0
TOKEN_UNIT_PRICE_NO_VIDEO_YUAN=0
TOKEN_ESTIMATE_SAFETY_MULTIPLIER=1.10

# ---- 日志 ----
LOG_LEVEL=INFO
LOG_FILE=logs/seedance.log
LOG_MAX_BYTES=10485760
LOG_BACKUP_COUNT=5

# ---- 首个管理员：仅初始化时使用 ----
ADMIN_USERNAME=admin
ADMIN_PASSWORD=请替换为强密码
ADMIN_TOKEN_QUOTA=0
